# ==========================================
# VORTEX SOCIAL APP
# ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# APPLICATION
# ------------------------------------------

NODE_ENV=development

PORT=3000

HOST=0.0.0.0


# ------------------------------------------
# FRONTEND / CORS
# ------------------------------------------

# Local development
CLIENT_ORIGIN=http://localhost:3000

# Production example:
# CLIENT_ORIGIN=https://your-vortex-domain.com


# ------------------------------------------
# DATABASE
# ------------------------------------------

# SQLite database location
DATABASE_PATH=./data/vortex.db


# ------------------------------------------
# AUTHENTICATION
# ------------------------------------------

# Session lifetime in seconds
SESSION_TTL=604800

# 604800 = 7 days


# ------------------------------------------
# SECURITY
# ------------------------------------------

# Generate a long random value for production.
# Do NOT commit the real value to GitHub.

SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET


# ------------------------------------------
# FILE / MEDIA STORAGE
# ------------------------------------------

UPLOAD_DIR=./uploads

MAX_UPLOAD_SIZE=104857600

# 100 MB


# ------------------------------------------
# VORTEX APP
# ------------------------------------------

APP_NAME=VORTEX

APP_VERSION=1.0.0

APP_TAGLINE=Connect. Create. Discover.


# ------------------------------------------
# LOGGING
# ------------------------------------------

LOG_LEVEL=info


# ------------------------------------------
# RATE LIMITING
# ------------------------------------------

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=300


# ------------------------------------------
# OPTIONAL EMAIL
# ------------------------------------------

EMAIL_ENABLED=false

EMAIL_FROM=

SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASSWORD=


# ------------------------------------------
# OPTIONAL CLOUD STORAGE
# ------------------------------------------

STORAGE_PROVIDER=local

STORAGE_BUCKET=

STORAGE_REGION=

STORAGE_ACCESS_KEY=

STORAGE_SECRET_KEY=


# ------------------------------------------
# OPTIONAL PAYMENT SYSTEM
# ------------------------------------------

PAYMENTS_ENABLED=false

PAYMENT_PROVIDER=

PAYMENT_PUBLIC_KEY=

PAYMENT_SECRET_KEY=


# ------------------------------------------
# OPTIONAL AI
# ------------------------------------------

VORTEX_AI_ENABLED=false

AI_PROVIDER=

AI_API_KEY=


# ------------------------------------------
# PRODUCTION
# ------------------------------------------

TRUST_PROXY=false

COOKIE_SECURE=false
