// VORTEX BACKEND - BOSS BRILLIANT EDITION - Node.js + Express
// Handles: Themes, Posts, Stories, Users, Marketplace, Friends, Reels
// Run: npm install express cors multer && node backend.js

const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');
const app = express();

app.use(cors());
app.use(express.json({limit:'20mb'}));
app.use(express.static(__dirname));

// Database - simple JSON files (you can upgrade to MongoDB later)
const DB_FILE = './vortex-db.json';

function loadDB(){
  if(!fs.existsSync(DB_FILE)){
    fs.writeFileSync(DB_FILE, JSON.stringify({
      users:[{id:1,name:"Brilliant Mere",email:"boss@vortex.com",pic:"https://i.pravatar.cc/200?img=32",themeId:3}],
      posts:[],
      stories:[],
      marketplace:[],
      themes:[
        {id:1,name:"Electric Blue Vortex",c1:"#38bdf8",c2:"#0ea5e9",c3:"#7dd3fc"},
        {id:2,name:"Purple Galaxy",c1:"#a78bfa",c2:"#7c3aed",c3:"#ec4899"},
        {id:3,name:"Cyber Rainbow",c1:"#f472b6",c2:"#38bdf8",c3:"#a78bfa"},
        {id:4,name:"Crystal Glass Neon",c1:"#22d3ee",c2:"#a78bfa",c3:"#ffffff"},
        {id:5,name:"Neon Fire",c1:"#f97316",c2:"#ef4444",c3:"#facc15"},
        {id:6,name:"Deep Space Vortex",c1:"#7c3aed",c2:"#000000",c3:"#38bdf8"},
        {id:7,name:"Electric Energy",c1:"#eab308",c2:"#f97316",c3:"#ffffff"},
        {id:8,name:"Neon Matrix",c1:"#22c55e",c2:"#000000",c3:"#4ade80"},
        {id:9,name:"Pink/Purple Glow",c1:"#ec4899",c2:"#a855f7",c3:"#f472b6"},
        {id:10,name:"Vortex Ocean",c1:"#06b6d4",c2:"#0e7490",c3:"#67e8f9"}
      ]
    },null,2));
  }
  return JSON.parse(fs.readFileSync(DB_FILE));
}
function saveDB(db){ fs.writeFileSync(DB_FILE, JSON.stringify(db,null,2)); }

// ===== ROUTES =====

// 1. GET ALL THEME PACK - Your 10 themes numbered
app.get('/api/themes', (req,res)=>{
  const db = loadDB();
  res.json(db.themes);
});

// 2. SAVE USER THEME CHOICE - User picks #3 etc
app.post('/api/theme/save', (req,res)=>{
  const {userId, themeId} = req.body;
  const db = loadDB();
  const user = db.users.find(u=>u.id==userId) || db.users[0];
  user.themeId = themeId;
  saveDB(db);
  res.json({success:true, message:`Theme #${themeId} saved!`, theme: db.themes.find(t=>t.id==themeId)});
});

// 3. POSTS - Create post live
app.get('/api/posts', (req,res)=>{ res.json(loadDB().posts); });
app.post('/api/posts', (req,res)=>{
  const db = loadDB();
  const post = {id:Date.now(),...req.body, likes:0, comments:[], createdAt:new Date()};
  db.posts.unshift(post);
  saveDB(db);
  res.json(post);
});
app.post('/api/posts/:id/like', (req,res)=>{
  const db = loadDB();
  const p = db.posts.find(x=>x.id==req.params.id);
  if(p){ p.likes = (p.likes||0)+1; saveDB(db); }
  res.json(p);
});
app.post('/api/posts/:id/comment', (req,res)=>{
  const db = loadDB();
  const p = db.posts.find(x=>x.id==req.params.id);
  if(p){ p.comments.push({name:req.body.name||"Brilliant", text:req.body.text, time:new Date()}); saveDB(db); }
  res.json(p);
});

// 4. STORIES - Live story upload
app.get('/api/stories', (req,res)=>{ res.json(loadDB().stories); });
app.post('/api/stories', (req,res)=>{
  const db = loadDB();
  db.stories.unshift({id:Date.now(), img:req.body.img, user:req.body.user||"Brilliant", time:new Date()});
  saveDB(db);
  res.json({success:true});
});

// 5. MARKETPLACE
app.get('/api/market', (req,res)=>{ res.json(loadDB().marketplace); });
app.post('/api/market', (req,res)=>{
  const db = loadDB();
  db.marketplace.unshift({id:Date.now(),...req.body});
  saveDB(db);
  res.json({success:true});
});

// 6. USER SETTINGS - Part of JS
app.get('/api/settings/:userId', (req,res)=>{
  const db = loadDB();
  const user = db.users.find(u=>u.id==req.params.userId) || db.users[0];
  res.json(user);
});
app.post('/api/settings', (req,res)=>{
  const db = loadDB();
  let user = db.users.find(u=>u.id==req.body.id);
  if(!user){ user = {id:Date.now(),...req.body}; db.users.push(user); }
  else{ Object.assign(user, req.body); }
  saveDB(db);
  res.json(user);
});

// Start
const PORT = process.env.PORT || 3000;
app.listen(PORT, ()=>console.log(`🚀 VORTEX Backend LIVE on port ${PORT} - Boss Brilliant! Themes pack ready at /api/themes`));
